{
  "name": "smazhena-kava-lab-07",
  "version": "1.0.0",
  "private": true,
  "description": "Смажена Кава — ЛР №7: проєктування та реалізація повноцінного лендингу",
  "scripts": {
    "format": "prettier --write \"*.html\" \"products/*.html\" \"css/*.css\" \"js/*.js\"",
    "build:css": "tailwindcss -i css/tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i css/tailwind.input.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.17"
  }
