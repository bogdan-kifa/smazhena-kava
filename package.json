{
  "name": "smazhena-kava",
  "version": "1.0.0",
  "private": true,
  "description": "Смажена Кава — сайт кавового бренду з каталогом зерна, конструктором міксу та підбором кави за смаком.",
  "scripts": {
    "format": "prettier --write \"*.html\" \"products/*.html\" \"css/*.css\" \"js/*.js\"",
    "build:css": "tailwindcss -i css/tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i css/tailwind.input.css -o css/tailwind.css --watch",
    "start": "node --env-file-if-exists=.env server/index.cjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.cjs",
    "build": "node server/build.cjs",
    "test:backend": "node --test server/tests/*.test.cjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.17"
  },
  "author": "Богдан Кіфа",
  "repository": {
    "type": "git",
    "url": "https://github.com/bogdan-kifa/smazhena-kava.git"
  },
  "homepage": "https://bogdan-kifa.github.io/smazhena-kava/",
  "bugs": {
    "url": "https://github.com/bogdan-kifa/smazhena-kava/issues"
  },
  "keywords": [
    "coffee",
    "ecommerce",
    "vanilla-javascript",
    "tailwindcss",
    "responsive-design"
  ],
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
